// BACKUP - Ancien ClientLayoutComponent
// Sauvegardé le 16/04/2026
import { Component } from '@angular/core';
import { Router } from '@angular/router';

@Component({
  selector: 'app-client-layout',
  template: `
    <div class="client-layout">
      <!-- Client Header -->
      <header class="client-header">
        <div class="header-brand" (click)="goToHome()">
          <i class="bi bi-shop"></i>
          <span>Synchub Store</span>
        </div>
        
        <nav class="header-nav">
          <a [class.active]="isActive('/boutiques')" (click)="router.navigate(['/boutiques'])">
            <i class="bi bi-shop"></i>
            Boutiques
          </a>
          <a [class.active]="isActive('/produits')" (click)="router.navigate(['/produits'])">
            <i class="bi bi-box-seam"></i>
            Produits
          </a>
          <a [class.active]="isActive('/commandes')" (click)="router.navigate(['/commandes'])">
            <i class="bi bi-cart"></i>
            Commandes
          </a>
          <a [class.active]="isActive('/livraisons')" (click)="router.navigate(['/livraisons'])">
            <i class="bi bi-truck"></i>
            Livraisons
          </a>
        </nav>

        <div class="header-actions">
          <button class="btn-dashboard" (click)="goToDashboard()" title="Dashboard Admin">
            <i class="bi bi-grid-3x3-gap-fill"></i>
            <span>Dashboard</span>
          </button>
        </div>
      </header>

      <!-- Main Content -->
      <main class="client-main">
        <router-outlet></router-outlet>
      </main>

      <!-- Client Footer -->
      <footer class="client-footer">
        <p>© 2026 Synchub Store. Tous droits réservés.</p>
        <button class="btn-dashboard-sm" (click)="goToDashboard()">
          <i class="bi bi-grid-3x3-gap-fill"></i>
          Dashboard Admin
        </button>
      </footer>
    </div>
  `,
  styles: [`
    .client-layout {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      background: linear-gradient(135deg, #0a0e27 0%, #1a1f4b 50%, #0d1235 100%);
      color: #fff;
    }

    /* Header */
    .client-header {
      position: sticky;
      top: 0;
      z-index: 100;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 1rem 2rem;
      background: rgba(10, 14, 39, 0.95);
      backdrop-filter: blur(10px);
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }

    .header-brand {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      font-size: 1.5rem;
      font-weight: 700;
      color: #fff;
      cursor: pointer;
      transition: color 0.3s;
    }

    .header-brand:hover {
      color: #6366f1;
    }

    .header-brand i {
      color: #6366f1;
      font-size: 1.75rem;
    }

    .header-nav {
      display: flex;
      gap: 0.5rem;
    }

    .header-nav a {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.6rem 1rem;
      color: rgba(255, 255, 255, 0.7);
      text-decoration: none;
      border-radius: 8px;
      font-weight: 500;
      transition: all 0.3s;
      cursor: pointer;
    }

    .header-nav a:hover {
      color: #fff;
      background: rgba(255, 255, 255, 0.1);
    }

    .header-nav a.active {
      color: #6366f1;
      background: rgba(99, 102, 241, 0.2);
    }

    .header-actions {
      display: flex;
      align-items: center;
      gap: 1rem;
    }

    .btn-dashboard {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.6rem 1.2rem;
      background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
      color: #fff;
      border: none;
      border-radius: 8px;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.3s;
    }

    .btn-dashboard:hover {
      transform: translateY(-2px);
      box-shadow: 0 4px 15px rgba(99, 102, 241, 0.4);
    }

    /* Main */
    .client-main {
      flex: 1;
      padding: 2rem;
      max-width: 1400px;
      width: 100%;
      margin: 0 auto;
    }

    /* Footer */
    .client-footer {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 1.5rem 2rem;
      background: rgba(0, 0, 0, 0.3);
      border-top: 1px solid rgba(255, 255, 255, 0.1);
    }

    .client-footer p {
      color: rgba(255, 255, 255, 0.5);
      margin: 0;
    }

    .btn-dashboard-sm {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.5rem 1rem;
      background: rgba(99, 102, 241, 0.2);
      color: #6366f1;
      border: 1px solid #6366f1;
      border-radius: 6px;
      font-size: 0.875rem;
      font-weight: 500;
      cursor: pointer;
      transition: all 0.3s;
    }

    .btn-dashboard-sm:hover {
      background: #6366f1;
      color: #fff;
    }

    /* Responsive */
    @media (max-width: 768px) {
      .client-header {
        flex-wrap: wrap;
        gap: 1rem;
      }

      .header-nav {
        order: 3;
        width: 100%;
        justify-content: center;
        overflow-x: auto;
      }

      .header-nav a span {
        display: none;
      }

      .btn-dashboard span {
        display: none;
      }

      .client-main {
        padding: 1rem;
      }

      .client-footer {
        flex-direction: column;
        gap: 1rem;
        text-align: center;
      }
    }
  `],
  standalone: false
})
export class ClientLayoutComponentBackup {
  constructor(public router: Router) {}

  isActive(path: string): boolean {
    return this.router.url.startsWith(path);
  }

  goToHome(): void {
    this.router.navigate(['/']);
  }

  goToDashboard(): void {
    this.router.navigate(['/admin/dashboard']);
  }
}
